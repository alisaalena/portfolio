<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:dmndi="https://www.omg.org/spec/DMN/20191111/DMNDI/" xmlns:dc="http://www.omg.org/spec/DMN/20180521/DC/" xmlns:di="http://www.omg.org/spec/DMN/20180521/DI/" id="Defs_dopuski" name="Допуски прогона" namespace="demo.ctr" exporter="hand" exporterVersion="6.0">
  <inputData id="ID_msg" name="Сообщение кнопки" />
  <inputData id="ID_day" name="Сегодня понедельник?" />
  <inputData id="ID_usl" name="Уточнение (что видно в задаче или файле)" />
  <decision id="Dec_gate" name="Решение кнопки на воротах">
    <decisionTable id="DT_gate" hitPolicy="FIRST">
      <input id="DT_gate_in0" label="Шаг"><inputExpression id="DT_gate_ie0" typeRef="string"><text>shag</text></inputExpression></input>
      <input id="DT_gate_in1" label="Источник"><inputExpression id="DT_gate_ie1" typeRef="string"><text>istochnik</text></inputExpression></input>
      <input id="DT_gate_in2" label="Состояние"><inputExpression id="DT_gate_ie2" typeRef="string"><text>sostoyanie</text></inputExpression></input>
      <output id="DT_gate_out0" label="Решение кнопки" name="reshenie" typeRef="string" />
      <output id="DT_gate_out1" label="Группа данных" name="gruppa" typeRef="string" />
      <output id="DT_gate_out2" label="На странице / в выводе" name="na_stranice" typeRef="string" />
      <rule id="DT_gate_r01"><description>README, шаг 2</description>
        <inputEntry id="DT_gate_r01_i0"><text>"2"</text></inputEntry>
        <inputEntry id="DT_gate_r01_i1"><text>"Снимок"</text></inputEntry>
        <inputEntry id="DT_gate_r01_i2"><text>"снимок не завершён, пустой, прошёл не по всем площадкам или нет доступов"</text></inputEntry>
        <outputEntry id="DT_gate_r01_o0"><text>"стоп"</text></outputEntry>
        <outputEntry id="DT_gate_r01_o1"><text>"скоропортящиеся"</text></outputEntry>
        <outputEntry id="DT_gate_r01_o2"><text>"Стоп с причиной"</text></outputEntry>
      </rule>
      <rule id="DT_gate_r02"><description>README, шаги 2 и 6</description>
        <inputEntry id="DT_gate_r02_i0"><text>"2"</text></inputEntry>
        <inputEntry id="DT_gate_r02_i1"><text>"Снимок"</text></inputEntry>
        <inputEntry id="DT_gate_r02_i2"><text>"сбой после снимка, файл снимка есть"</text></inputEntry>
        <outputEntry id="DT_gate_r02_o0"><text>"предупреждение"</text></outputEntry>
        <outputEntry id="DT_gate_r02_o1"><text>"скоропортящиеся"</text></outputEntry>
        <outputEntry id="DT_gate_r02_o2"><text>"Вопрос «собирать?»; обложки вернёт перезапуск снимка в тот же день"</text></outputEntry>
      </rule>
      <rule id="DT_gate_r03"><description>README, шаг 2</description>
        <inputEntry id="DT_gate_r03_i0"><text>"2"</text></inputEntry>
        <inputEntry id="DT_gate_r03_i1"><text>"Сервер"</text></inputEntry>
        <inputEntry id="DT_gate_r03_i2"><text>"не ответил (нет связи)"</text></inputEntry>
        <outputEntry id="DT_gate_r03_o0"><text>"стоп"</text></outputEntry>
        <outputEntry id="DT_gate_r03_o1"><text>"служебные"</text></outputEntry>
        <outputEntry id="DT_gate_r03_o2"><text>"Свой стоп с причиной"</text></outputEntry>
      </rule>
      <rule id="DT_gate_r04"><description>README, ключи допуска</description>
        <inputEntry id="DT_gate_r04_i0"><text>"3"</text></inputEntry>
        <inputEntry id="DT_gate_r04_i1"><text>"Рынок ВБ"</text></inputEntry>
        <inputEntry id="DT_gate_r04_i2"><text>"не собран, запуск с допуском «без рынка ВБ»"</text></inputEntry>
        <outputEntry id="DT_gate_r04_o0"><text>"дальше"</text></outputEntry>
        <outputEntry id="DT_gate_r04_o1"><text>"восстановимые"</text></outputEntry>
        <outputEntry id="DT_gate_r04_o2"><text>"Без сравнения с рынком ВБ"</text></outputEntry>
      </rule>
      <rule id="DT_gate_r05"><description>README, шаги 3 и 6</description>
        <inputEntry id="DT_gate_r05_i0"><text>"3"</text></inputEntry>
        <inputEntry id="DT_gate_r05_i1"><text>"Рынок ВБ"</text></inputEntry>
        <inputEntry id="DT_gate_r05_i2"><text>"не собран, без ключа"</text></inputEntry>
        <outputEntry id="DT_gate_r05_o0"><text>"предупреждение"</text></outputEntry>
        <outputEntry id="DT_gate_r05_o1"><text>"восстановимые"</text></outputEntry>
        <outputEntry id="DT_gate_r05_o2"><text>"Вопрос «собирать?»; без сравнения с рынком ВБ"</text></outputEntry>
      </rule>
      <rule id="DT_gate_r06"><description>README, шаг 3; регламент ч. 2</description>
        <inputEntry id="DT_gate_r06_i0"><text>"3"</text></inputEntry>
        <inputEntry id="DT_gate_r06_i1"><text>"Рынок ВБ"</text></inputEntry>
        <inputEntry id="DT_gate_r06_i2"><text>"площадка отказала по части предметов"</text></inputEntry>
        <outputEntry id="DT_gate_r06_o0"><text>"предупреждение"</text></outputEntry>
        <outputEntry id="DT_gate_r06_o1"><text>"восстановимые"</text></outputEntry>
        <outputEntry id="DT_gate_r06_o2"><text>"«ПЛОЩАДКА ОТКАЗАЛА по предметам»; прогон идёт дальше"</text></outputEntry>
      </rule>
      <rule id="DT_gate_r07"><description>README, шаг 4</description>
        <inputEntry id="DT_gate_r07_i0"><text>"4"</text></inputEntry>
        <inputEntry id="DT_gate_r07_i1"><text>"Раскладка"</text></inputEntry>
        <inputEntry id="DT_gate_r07_i2"><text>"оригинал занят (Excel, индексатор)"</text></inputEntry>
        <outputEntry id="DT_gate_r07_o0"><text>"дальше"</text></outputEntry>
        <outputEntry id="DT_gate_r07_o1"><text>"служебные"</text></outputEntry>
        <outputEntry id="DT_gate_r07_o2"><text>"Файл разложен копией"</text></outputEntry>
      </rule>
      <rule id="DT_gate_r08"><description>README, шаг 4</description>
        <inputEntry id="DT_gate_r08_i0"><text>"4"</text></inputEntry>
        <inputEntry id="DT_gate_r08_i1"><text>"Раскладка"</text></inputEntry>
        <inputEntry id="DT_gate_r08_i2"><text>"файл не читается или не перенёсся"</text></inputEntry>
        <outputEntry id="DT_gate_r08_o0"><text>"стоп"</text></outputEntry>
        <outputEntry id="DT_gate_r08_o1"><text>"служебные"</text></outputEntry>
        <outputEntry id="DT_gate_r08_o2"><text>"«Заняты другим процессом» с причиной"</text></outputEntry>
      </rule>
      <rule id="DT_gate_r09"><description>код кнопки, ключ допуска</description>
        <inputEntry id="DT_gate_r09_i0"><text>"5"</text></inputEntry>
        <inputEntry id="DT_gate_r09_i1"><text>"Аналитика брендов Маркета"</text></inputEntry>
        <inputEntry id="DT_gate_r09_i2"><text>"нет, запуск с допуском «без рынка Маркета»"</text></inputEntry>
        <outputEntry id="DT_gate_r09_o0"><text>"дальше"</text></outputEntry>
        <outputEntry id="DT_gate_r09_o1"><text>"восстановимые"</text></outputEntry>
        <outputEntry id="DT_gate_r09_o2"><text>"«Рынок за неделю не выгружен»"</text></outputEntry>
      </rule>
      <rule id="DT_gate_r10"><description>код кнопки</description>
        <inputEntry id="DT_gate_r10_i0"><text>"5"</text></inputEntry>
        <inputEntry id="DT_gate_r10_i1"><text>"Аналитика брендов Маркета"</text></inputEntry>
        <inputEntry id="DT_gate_r10_i2"><text>"нет или не принята, без ключа"</text></inputEntry>
        <outputEntry id="DT_gate_r10_o0"><text>"стоп"</text></outputEntry>
        <outputEntry id="DT_gate_r10_o1"><text>"восстановимые"</text></outputEntry>
        <outputEntry id="DT_gate_r10_o2"><text>"«аналитика брендов Маркета не принята»"</text></outputEntry>
      </rule>
      <rule id="DT_gate_r11"><description>код кнопки; регламент ч. 3</description>
        <inputEntry id="DT_gate_r11_i0"><text>"5"</text></inputEntry>
        <inputEntry id="DT_gate_r11_i1"><text>"Рыночные выборки Ozon"</text></inputEntry>
        <inputEntry id="DT_gate_r11_i2"><text>"не приняты"</text></inputEntry>
        <outputEntry id="DT_gate_r11_o0"><text>"стоп"</text></outputEntry>
        <outputEntry id="DT_gate_r11_o1"><text>"скоропортящиеся"</text></outputEntry>
        <outputEntry id="DT_gate_r11_o2"><text>"«рыночные выборки Ozon не приняты»"</text></outputEntry>
      </rule>
      <rule id="DT_gate_r12"><description>код кнопки; регламент ч. 3</description>
        <inputEntry id="DT_gate_r12_i0"><text>"5"</text></inputEntry>
        <inputEntry id="DT_gate_r12_i1"><text>"Воронка ВБ"</text></inputEntry>
        <inputEntry id="DT_gate_r12_i2"><text>"не сошлась с рынком ВБ или не принята"</text></inputEntry>
        <outputEntry id="DT_gate_r12_o0"><text>"стоп"</text></outputEntry>
        <outputEntry id="DT_gate_r12_o1"><text>"восстановимые"</text></outputEntry>
        <outputEntry id="DT_gate_r12_o2"><text>"«воронка и рынок ВБ не сошлись» / «воронка ВБ не принята»"</text></outputEntry>
      </rule>
      <rule id="DT_gate_r13"><description>код кнопки</description>
        <inputEntry id="DT_gate_r13_i0"><text>"5"</text></inputEntry>
        <inputEntry id="DT_gate_r13_i1"><text>"Отчёт «Товары» Ozon"</text></inputEntry>
        <inputEntry id="DT_gate_r13_i2"><text>"не принят"</text></inputEntry>
        <outputEntry id="DT_gate_r13_o0"><text>"стоп"</text></outputEntry>
        <outputEntry id="DT_gate_r13_o1"><text>"восстановимые"</text></outputEntry>
        <outputEntry id="DT_gate_r13_o2"><text>"Перевыгрузить можно и завтра"</text></outputEntry>
      </rule>
      <rule id="DT_gate_r14"><description>README, правила кода</description>
        <inputEntry id="DT_gate_r14_i0"><text>"5"</text></inputEntry>
        <inputEntry id="DT_gate_r14_i1"><text>"Файл сервера"</text></inputEntry>
        <inputEntry id="DT_gate_r14_i2"><text>"неопознанный штатный файл"</text></inputEntry>
        <outputEntry id="DT_gate_r14_o0"><text>"предупреждение"</text></outputEntry>
        <outputEntry id="DT_gate_r14_o1"><text>"служебные"</text></outputEntry>
        <outputEntry id="DT_gate_r14_o2"><text>"Код 2 и вопрос «собирать?»"</text></outputEntry>
      </rule>
      <rule id="DT_gate_r15"><description>README, шаг 5</description>
        <inputEntry id="DT_gate_r15_i0"><text>"5"</text></inputEntry>
        <inputEntry id="DT_gate_r15_i1"><text>"Скрипт приёмки"</text></inputEntry>
        <inputEntry id="DT_gate_r15_i2"><text>"файла нет"</text></inputEntry>
        <outputEntry id="DT_gate_r15_o0"><text>"стоп"</text></outputEntry>
        <outputEntry id="DT_gate_r15_o1"><text>"служебные"</text></outputEntry>
        <outputEntry id="DT_gate_r15_o2"><text>"Стоп: данные не проверены"</text></outputEntry>
      </rule>
      <rule id="DT_gate_r16"><description>README, шаг 7</description>
        <inputEntry id="DT_gate_r16_i0"><text>"7"</text></inputEntry>
        <inputEntry id="DT_gate_r16_i1"><text>"Копия на сервер"</text></inputEntry>
        <inputEntry id="DT_gate_r16_i2"><text>"не вышла"</text></inputEntry>
        <outputEntry id="DT_gate_r16_o0"><text>"дальше"</text></outputEntry>
        <outputEntry id="DT_gate_r16_o1"><text>"служебные"</text></outputEntry>
        <outputEntry id="DT_gate_r16_o2"><text>"Не стоп"</text></outputEntry>
      </rule>
      <rule id="DT_gate_r17"><description>README, шаг 6</description>
        <inputEntry id="DT_gate_r17_i0"><text>-</text></inputEntry>
        <inputEntry id="DT_gate_r17_i1"><text>-</text></inputEntry>
        <inputEntry id="DT_gate_r17_i2"><text>-</text></inputEntry>
        <outputEntry id="DT_gate_r17_o0"><text>"дальше"</text></outputEntry>
        <outputEntry id="DT_gate_r17_o1"><text>"—"</text></outputEntry>
        <outputEntry id="DT_gate_r17_o2"><text>"«Вопрос не задавался: приёмки чистые»"</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
  <decision id="Dec_act" name="Действие по регламенту">
    <informationRequirement id="IR_gate"><requiredDecision href="#Dec_gate" /></informationRequirement>
    <informationRequirement id="IR_msg"><requiredInput href="#ID_msg" /></informationRequirement>
    <informationRequirement id="IR_day"><requiredInput href="#ID_day" /></informationRequirement>
    <informationRequirement id="IR_usl"><requiredInput href="#ID_usl" /></informationRequirement>
    <decisionTable id="DT_act" hitPolicy="FIRST">
      <input id="DT_act_in0" label="Сигнал: кнопка, задача, страница"><inputExpression id="DT_act_ie0" typeRef="string"><text>soobshchenie</text></inputExpression></input>
      <input id="DT_act_in1" label="Сегодня понедельник?"><inputExpression id="DT_act_ie1" typeRef="boolean"><text>ponedelnik</text></inputExpression></input>
      <input id="DT_act_in2" label="Уточнение"><inputExpression id="DT_act_ie2" typeRef="string"><text>uslovie</text></inputExpression></input>
      <output id="DT_act_out0" label="Действие" name="deystvie" typeRef="string" />
      <output id="DT_act_out1" label="Сообщить владельцу?" name="vladelcu" typeRef="string" />
      <output id="DT_act_out2" label="Когда" name="kogda" typeRef="string" />
      <output id="DT_act_out3" label="Группа данных" name="gruppa" typeRef="string" />
      <output id="DT_act_out4" label="Написать пользователям (нюанс недели)" name="polzovatelyam" typeRef="string" />
      <rule id="DT_act_r01"><description>регламент, «Перед началом»</description>
        <inputEntry id="DT_act_r01_i0"><text>"задачи «Сбор CTR» нет к 9:00"</text></inputEntry>
        <inputEntry id="DT_act_r01_i1"><text>-</text></inputEntry>
        <inputEntry id="DT_act_r01_i2"><text>-</text></inputEntry>
        <outputEntry id="DT_act_r01_o0"><text>"Качать по задаче прошлой недели"</text></outputEntry>
        <outputEntry id="DT_act_r01_o1"><text>"написать и не ждать ответа"</text></outputEntry>
        <outputEntry id="DT_act_r01_o2"><text>"сразу"</text></outputEntry>
        <outputEntry id="DT_act_r01_o3"><text>"служебные"</text></outputEntry>
        <outputEntry id="DT_act_r01_o4"><text>"—"</text></outputEntry>
      </rule>
      <rule id="DT_act_r02"><description>README, шаг 0; регламент ч. 2</description>
        <inputEntry id="DT_act_r02_i0"><text>"СКРИПТЫ ОБНОВИЛИСЬ"</text></inputEntry>
        <inputEntry id="DT_act_r02_i1"><text>-</text></inputEntry>
        <inputEntry id="DT_act_r02_i2"><text>-</text></inputEntry>
        <outputEntry id="DT_act_r02_o0"><text>"Запустить кнопку ещё раз — приехало исправление, это не ошибка"</text></outputEntry>
        <outputEntry id="DT_act_r02_o1"><text>"нет — справляемся сами"</text></outputEntry>
        <outputEntry id="DT_act_r02_o2"><text>"сразу"</text></outputEntry>
        <outputEntry id="DT_act_r02_o3"><text>"служебные"</text></outputEntry>
        <outputEntry id="DT_act_r02_o4"><text>"—"</text></outputEntry>
      </rule>
      <rule id="DT_act_r03"><description>ч. 3</description>
        <inputEntry id="DT_act_r03_i0"><text>"нет папки сбора"</text></inputEntry>
        <inputEntry id="DT_act_r03_i1"><text>-</text></inputEntry>
        <inputEntry id="DT_act_r03_i2"><text>-</text></inputEntry>
        <outputEntry id="DT_act_r03_o0"><text>"Переименовать папку точно как в сообщении, запустить заново"</text></outputEntry>
        <outputEntry id="DT_act_r03_o1"><text>"нет — справляемся сами"</text></outputEntry>
        <outputEntry id="DT_act_r03_o2"><text>"сразу"</text></outputEntry>
        <outputEntry id="DT_act_r03_o3"><text>"служебные"</text></outputEntry>
        <outputEntry id="DT_act_r03_o4"><text>"—"</text></outputEntry>
      </rule>
      <rule id="DT_act_r04"><description>описание процесса, S1; владелец, 27.10</description>
        <inputEntry id="DT_act_r04_i0"><text>"нет журнала снимка"</text></inputEntry>
        <inputEntry id="DT_act_r04_i1"><text>true</text></inputEntry>
        <inputEntry id="DT_act_r04_i2"><text>-</text></inputEntry>
        <outputEntry id="DT_act_r04_o0"><text>"Владелец перезапускает снимок на сервере сегодня, потом кнопка заново. Ручных выгрузок взамен нет"</text></outputEntry>
        <outputEntry id="DT_act_r04_o1"><text>"да — сразу"</text></outputEntry>
        <outputEntry id="DT_act_r04_o2"><text>"сегодня"</text></outputEntry>
        <outputEntry id="DT_act_r04_o3"><text>"скоропортящиеся"</text></outputEntry>
        <outputEntry id="DT_act_r04_o4"><text>"—"</text></outputEntry>
      </rule>
      <rule id="DT_act_r05"><description>описание процесса, S1; владелец, 27.10</description>
        <inputEntry id="DT_act_r05_i0"><text>"снимок прошёл не полностью"</text></inputEntry>
        <inputEntry id="DT_act_r05_i1"><text>true</text></inputEntry>
        <inputEntry id="DT_act_r05_i2"><text>-</text></inputEntry>
        <outputEntry id="DT_act_r05_o0"><text>"Владелец перезапускает снимок на сервере сегодня, потом кнопка заново. Ручных выгрузок взамен нет"</text></outputEntry>
        <outputEntry id="DT_act_r05_o1"><text>"да — сразу"</text></outputEntry>
        <outputEntry id="DT_act_r05_o2"><text>"сегодня"</text></outputEntry>
        <outputEntry id="DT_act_r05_o3"><text>"скоропортящиеся"</text></outputEntry>
        <outputEntry id="DT_act_r05_o4"><text>"—"</text></outputEntry>
      </rule>
      <rule id="DT_act_r06"><description>ч. 3; описание процесса, S1</description>
        <inputEntry id="DT_act_r06_i0"><text>"нет журнала снимка"</text></inputEntry>
        <inputEntry id="DT_act_r06_i1"><text>false</text></inputEntry>
        <inputEntry id="DT_act_r06_i2"><text>-</text></inputEntry>
        <outputEntry id="DT_act_r06_o0"><text>"Снимок задним числом не взять. Дальше по части 6"</text></outputEntry>
        <outputEntry id="DT_act_r06_o1"><text>"написать и не ждать ответа"</text></outputEntry>
        <outputEntry id="DT_act_r06_o2"><text>"—"</text></outputEntry>
        <outputEntry id="DT_act_r06_o3"><text>"скоропортящиеся"</text></outputEntry>
        <outputEntry id="DT_act_r06_o4"><text>"Изменения карточек за неделю не сохранены: снимок не снялся"</text></outputEntry>
      </rule>
      <rule id="DT_act_r07"><description>ч. 3; описание процесса, S1</description>
        <inputEntry id="DT_act_r07_i0"><text>"снимок прошёл не полностью"</text></inputEntry>
        <inputEntry id="DT_act_r07_i1"><text>false</text></inputEntry>
        <inputEntry id="DT_act_r07_i2"><text>-</text></inputEntry>
        <outputEntry id="DT_act_r07_o0"><text>"Дальше по части 6"</text></outputEntry>
        <outputEntry id="DT_act_r07_o1"><text>"написать и не ждать ответа"</text></outputEntry>
        <outputEntry id="DT_act_r07_o2"><text>"—"</text></outputEntry>
        <outputEntry id="DT_act_r07_o3"><text>"скоропортящиеся"</text></outputEntry>
        <outputEntry id="DT_act_r07_o4"><text>"Изменения карточек за неделю — не по всем площадкам"</text></outputEntry>
      </rule>
      <rule id="DT_act_r08"><description>ч. 3</description>
        <inputEntry id="DT_act_r08_i0"><text>"не забрались выгрузки сервера"</text></inputEntry>
        <inputEntry id="DT_act_r08_i1"><text>-</text></inputEntry>
        <inputEntry id="DT_act_r08_i2"><text>-</text></inputEntry>
        <outputEntry id="DT_act_r08_o0"><text>"Продолжать: эти данные доберутся позже"</text></outputEntry>
        <outputEntry id="DT_act_r08_o1"><text>"написать и не ждать ответа"</text></outputEntry>
        <outputEntry id="DT_act_r08_o2"><text>"можно позже"</text></outputEntry>
        <outputEntry id="DT_act_r08_o3"><text>"восстановимые"</text></outputEntry>
        <outputEntry id="DT_act_r08_o4"><text>"—"</text></outputEntry>
      </rule>
      <rule id="DT_act_r09"><description>ч. 3</description>
        <inputEntry id="DT_act_r09_i0"><text>"рыночные выборки Ozon не приняты"</text></inputEntry>
        <inputEntry id="DT_act_r09_i1"><text>true</text></inputEntry>
        <inputEntry id="DT_act_r09_i2"><text>-</text></inputEntry>
        <outputEntry id="DT_act_r09_o0"><text>"Перевыгрузить: снять фильтр «Мои товары», проверить категорию и 7 дней"</text></outputEntry>
        <outputEntry id="DT_act_r09_o1"><text>"нет — справляемся сами"</text></outputEntry>
        <outputEntry id="DT_act_r09_o2"><text>"сегодня"</text></outputEntry>
        <outputEntry id="DT_act_r09_o3"><text>"скоропортящиеся"</text></outputEntry>
        <outputEntry id="DT_act_r09_o4"><text>"—"</text></outputEntry>
      </rule>
      <rule id="DT_act_r10"><description>ч. 3</description>
        <inputEntry id="DT_act_r10_i0"><text>"рыночные выборки Ozon не приняты"</text></inputEntry>
        <inputEntry id="DT_act_r10_i1"><text>false</text></inputEntry>
        <inputEntry id="DT_act_r10_i2"><text>-</text></inputEntry>
        <outputEntry id="DT_act_r10_o0"><text>"Неделю рынка Ozon уже не собрать. Дальше по части 6"</text></outputEntry>
        <outputEntry id="DT_act_r10_o1"><text>"написать и не ждать ответа"</text></outputEntry>
        <outputEntry id="DT_act_r10_o2"><text>"—"</text></outputEntry>
        <outputEntry id="DT_act_r10_o3"><text>"скоропортящиеся"</text></outputEntry>
        <outputEntry id="DT_act_r10_o4"><text>"Ozon: сравнения с рынком за неделю нет — окно площадки ушло"</text></outputEntry>
      </rule>
      <rule id="DT_act_r11"><description>ч. 3</description>
        <inputEntry id="DT_act_r11_i0"><text>"аналитика брендов Маркета не принята"</text></inputEntry>
        <inputEntry id="DT_act_r11_i1"><text>-</text></inputEntry>
        <inputEntry id="DT_act_r11_i2"><text>"категории не было в поиске"</text></inputEntry>
        <outputEntry id="DT_act_r11_o0"><text>"Пробовать в следующий понедельник; появится — пересобрать неделю"</text></outputEntry>
        <outputEntry id="DT_act_r11_o1"><text>"написать и не ждать ответа"</text></outputEntry>
        <outputEntry id="DT_act_r11_o2"><text>"—"</text></outputEntry>
        <outputEntry id="DT_act_r11_o3"><text>"восстановимые"</text></outputEntry>
        <outputEntry id="DT_act_r11_o4"><text>"Маркет: категория не отдаётся площадкой; вернётся — восполним"</text></outputEntry>
      </rule>
      <rule id="DT_act_r12"><description>ч. 3</description>
        <inputEntry id="DT_act_r12_i0"><text>"аналитика брендов Маркета не принята"</text></inputEntry>
        <inputEntry id="DT_act_r12_i1"><text>-</text></inputEntry>
        <inputEntry id="DT_act_r12_i2"><text>-</text></inputEntry>
        <outputEntry id="DT_act_r12_o0"><text>"Перевыгрузить"</text></outputEntry>
        <outputEntry id="DT_act_r12_o1"><text>"нет — справляемся сами"</text></outputEntry>
        <outputEntry id="DT_act_r12_o2"><text>"можно завтра"</text></outputEntry>
        <outputEntry id="DT_act_r12_o3"><text>"восстановимые"</text></outputEntry>
        <outputEntry id="DT_act_r12_o4"><text>"—"</text></outputEntry>
      </rule>
      <rule id="DT_act_r13"><description>ч. 3</description>
        <inputEntry id="DT_act_r13_i0"><text>"в папке недели лежит не то или не там"</text></inputEntry>
        <inputEntry id="DT_act_r13_i1"><text>-</text></inputEntry>
        <inputEntry id="DT_act_r13_i2"><text>-</text></inputEntry>
        <outputEntry id="DT_act_r13_o0"><text>"Найти файл из сообщения; обычно выгрузка за другой период"</text></outputEntry>
        <outputEntry id="DT_act_r13_o1"><text>"нет — справляемся сами"</text></outputEntry>
        <outputEntry id="DT_act_r13_o2"><text>"сразу"</text></outputEntry>
        <outputEntry id="DT_act_r13_o3"><text>"служебные"</text></outputEntry>
        <outputEntry id="DT_act_r13_o4"><text>"—"</text></outputEntry>
      </rule>
      <rule id="DT_act_r14"><description>ч. 3</description>
        <inputEntry id="DT_act_r14_i0"><text>"воронка и рынок ВБ не сошлись"</text></inputEntry>
        <inputEntry id="DT_act_r14_i1"><text>-</text></inputEntry>
        <inputEntry id="DT_act_r14_i2"><text>"период воронки не ровно 7 дней"</text></inputEntry>
        <outputEntry id="DT_act_r14_o0"><text>"Исправить период, перевыгрузить воронку"</text></outputEntry>
        <outputEntry id="DT_act_r14_o1"><text>"нет — справляемся сами"</text></outputEntry>
        <outputEntry id="DT_act_r14_o2"><text>"сразу"</text></outputEntry>
        <outputEntry id="DT_act_r14_o3"><text>"восстановимые"</text></outputEntry>
        <outputEntry id="DT_act_r14_o4"><text>"—"</text></outputEntry>
      </rule>
      <rule id="DT_act_r15"><description>ч. 3</description>
        <inputEntry id="DT_act_r15_i0"><text>"воронка и рынок ВБ не сошлись"</text></inputEntry>
        <inputEntry id="DT_act_r15_i1"><text>-</text></inputEntry>
        <inputEntry id="DT_act_r15_i2"><text>-</text></inputEntry>
        <outputEntry id="DT_act_r15_o0"><text>"Перевыгрузить воронку и СРАЗУ запустить кнопку"</text></outputEntry>
        <outputEntry id="DT_act_r15_o1"><text>"нет — справляемся сами"</text></outputEntry>
        <outputEntry id="DT_act_r15_o2"><text>"сразу"</text></outputEntry>
        <outputEntry id="DT_act_r15_o3"><text>"восстановимые"</text></outputEntry>
        <outputEntry id="DT_act_r15_o4"><text>"—"</text></outputEntry>
      </rule>
      <rule id="DT_act_r16"><description>ч. 3</description>
        <inputEntry id="DT_act_r16_i0"><text>"воронка ВБ не принята"</text></inputEntry>
        <inputEntry id="DT_act_r16_i1"><text>-</text></inputEntry>
