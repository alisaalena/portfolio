        <outputEntry id="DT_act_r25_o1"><text>"нет — справляемся сами"</text></outputEntry>
        <outputEntry id="DT_act_r25_o2"><text>"—"</text></outputEntry>
        <outputEntry id="DT_act_r25_o3"><text>"служебные"</text></outputEntry>
        <outputEntry id="DT_act_r25_o4"><text>"Новое на странице — кнопка «что нового»"</text></outputEntry>
      </rule>
      <rule id="DT_act_r26"><description>ч. 6</description>
        <inputEntry id="DT_act_r26_i0"><text>-</text></inputEntry>
        <inputEntry id="DT_act_r26_i1"><text>-</text></inputEntry>
        <inputEntry id="DT_act_r26_i2"><text>-</text></inputEntry>
        <outputEntry id="DT_act_r26_o0"><text>"Доделать что можно, сложить на Диск, записать шаг и текст на экране, закрыть понедельник"</text></outputEntry>
        <outputEntry id="DT_act_r26_o1"><text>"написать и не ждать ответа"</text></outputEntry>
        <outputEntry id="DT_act_r26_o2"><text>"сегодня"</text></outputEntry>
        <outputEntry id="DT_act_r26_o3"><text>"—"</text></outputEntry>
        <outputEntry id="DT_act_r26_o4"><text>"—"</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
