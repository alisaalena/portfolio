        <outputEntry id="DT_act_r16_o0"><text>"Проверить период воронки: ровно 7 дней"</text></outputEntry>
        <outputEntry id="DT_act_r16_o1"><text>"нет — справляемся сами"</text></outputEntry>
        <outputEntry id="DT_act_r16_o2"><text>"сразу"</text></outputEntry>
        <outputEntry id="DT_act_r16_o3"><text>"восстановимые"</text></outputEntry>
        <outputEntry id="DT_act_r16_o4"><text>"—"</text></outputEntry>
      </rule>
      <rule id="DT_act_r17"><description>ч. 3</description>
        <inputEntry id="DT_act_r17_i0"><text>"файлы заняты другим процессом"</text></inputEntry>
        <inputEntry id="DT_act_r17_i1"><text>-</text></inputEntry>
        <inputEntry id="DT_act_r17_i2"><text>-</text></inputEntry>
        <outputEntry id="DT_act_r17_o0"><text>"Закрыть Excel и проводник на «Загрузках», минута, запустить заново"</text></outputEntry>
        <outputEntry id="DT_act_r17_o1"><text>"нет — справляемся сами"</text></outputEntry>
        <outputEntry id="DT_act_r17_o2"><text>"сразу"</text></outputEntry>
        <outputEntry id="DT_act_r17_o3"><text>"служебные"</text></outputEntry>
        <outputEntry id="DT_act_r17_o4"><text>"—"</text></outputEntry>
      </rule>
      <rule id="DT_act_r18"><description>ч. 3</description>
        <inputEntry id="DT_act_r18_i0"><text>"сборка витрины не прошла"</text></inputEntry>
        <inputEntry id="DT_act_r18_i1"><text>-</text></inputEntry>
        <inputEntry id="DT_act_r18_i2"><text>-</text></inputEntry>
        <outputEntry id="DT_act_r18_o0"><text>"Данные разложены, ничего не потеряно"</text></outputEntry>
        <outputEntry id="DT_act_r18_o1"><text>"написать, переслать журнал"</text></outputEntry>
        <outputEntry id="DT_act_r18_o2"><text>"витрина позже"</text></outputEntry>
        <outputEntry id="DT_act_r18_o3"><text>"служебные"</text></outputEntry>
        <outputEntry id="DT_act_r18_o4"><text>"—"</text></outputEntry>
      </rule>
      <rule id="DT_act_r19"><description>ч. 2</description>
        <inputEntry id="DT_act_r19_i0"><text>"площадка отказала по предметам"</text></inputEntry>
        <inputEntry id="DT_act_r19_i1"><text>-</text></inputEntry>
        <inputEntry id="DT_act_r19_i2"><text>-</text></inputEntry>
        <outputEntry id="DT_act_r19_o0"><text>"Не остановка: прогон идёт дальше"</text></outputEntry>
        <outputEntry id="DT_act_r19_o1"><text>"после прогона — какие предметы"</text></outputEntry>
        <outputEntry id="DT_act_r19_o2"><text>"—"</text></outputEntry>
        <outputEntry id="DT_act_r19_o3"><text>"восстановимые"</text></outputEntry>
        <outputEntry id="DT_act_r19_o4"><text>"ВБ: по части предметов рынка нет — площадка отказала"</text></outputEntry>
      </rule>
      <rule id="DT_act_r20"><description>ч. 2</description>
        <inputEntry id="DT_act_r20_i0"><text>"рынок ВБ: не вышло"</text></inputEntry>
        <inputEntry id="DT_act_r20_i1"><text>-</text></inputEntry>
        <inputEntry id="DT_act_r20_i2"><text>-</text></inputEntry>
        <outputEntry id="DT_act_r20_o0"><text>"Не остановка: доскачать руками, положить куда скажет чат, перезапуск"</text></outputEntry>
        <outputEntry id="DT_act_r20_o1"><text>"нет — справляемся сами"</text></outputEntry>
        <outputEntry id="DT_act_r20_o2"><text>"можно позже"</text></outputEntry>
        <outputEntry id="DT_act_r20_o3"><text>"восстановимые"</text></outputEntry>
        <outputEntry id="DT_act_r20_o4"><text>"ВБ: сравнение с рынком появится после добора"</text></outputEntry>
      </rule>
      <rule id="DT_act_r21"><description>владелец, 27.10</description>
        <inputEntry id="DT_act_r21_i0"><text>"некому запустить кнопку сегодня"</text></inputEntry>
        <inputEntry id="DT_act_r21_i1"><text>-</text></inputEntry>
        <inputEntry id="DT_act_r21_i2"><text>-</text></inputEntry>
        <outputEntry id="DT_act_r21_o0"><text>"Страховочная выгрузка рынка ВБ руками; кнопку — когда оператор на месте"</text></outputEntry>
        <outputEntry id="DT_act_r21_o1"><text>"написать и не ждать ответа"</text></outputEntry>
        <outputEntry id="DT_act_r21_o2"><text>"сегодня"</text></outputEntry>
        <outputEntry id="DT_act_r21_o3"><text>"восстановимые"</text></outputEntry>
        <outputEntry id="DT_act_r21_o4"><text>"—"</text></outputEntry>
      </rule>
      <rule id="DT_act_r22"><description>владелец, 27.10</description>
        <inputEntry id="DT_act_r22_i0"><text>"не успеваем до 17:00"</text></inputEntry>
        <inputEntry id="DT_act_r22_i1"><text>-</text></inputEntry>
        <inputEntry id="DT_act_r22_i2"><text>-</text></inputEntry>
        <outputEntry id="DT_act_r22_o0"><text>"Скоропортящееся собрано? Витрину — на следующий рабочий день"</text></outputEntry>
        <outputEntry id="DT_act_r22_o1"><text>"нет — справляемся сами"</text></outputEntry>
        <outputEntry id="DT_act_r22_o2"><text>"завтра"</text></outputEntry>
        <outputEntry id="DT_act_r22_o3"><text>"служебные"</text></outputEntry>
        <outputEntry id="DT_act_r22_o4"><text>"—"</text></outputEntry>
      </rule>
      <rule id="DT_act_r23"><description>владелец, 27.10; задача «Изменилось»</description>
        <inputEntry id="DT_act_r23_i0"><text>"площадка объединила категории или добавила новые"</text></inputEntry>
        <inputEntry id="DT_act_r23_i1"><text>-</text></inputEntry>
        <inputEntry id="DT_act_r23_i2"><text>-</text></inputEntry>
        <outputEntry id="DT_act_r23_o0"><text>"Ничего: кнопка берёт список недели"</text></outputEntry>
        <outputEntry id="DT_act_r23_o1"><text>"нет — справляемся сами"</text></outputEntry>
        <outputEntry id="DT_act_r23_o2"><text>"—"</text></outputEntry>
        <outputEntry id="DT_act_r23_o3"><text>"служебные"</text></outputEntry>
        <outputEntry id="DT_act_r23_o4"><text>"Площадка изменила категории: что объединено, что добавлено"</text></outputEntry>
      </rule>
      <rule id="DT_act_r24"><description>владелец, 27.10</description>
        <inputEntry id="DT_act_r24_i0"><text>"источник пропущен не первую неделю"</text></inputEntry>
        <inputEntry id="DT_act_r24_i1"><text>-</text></inputEntry>
        <inputEntry id="DT_act_r24_i2"><text>-</text></inputEntry>
        <outputEntry id="DT_act_r24_o0"><text>"Только фиксация; каждый понедельник пробовать выгрузить прошлые недели; появились — переверстать недели с пробелами (в чате)"</text></outputEntry>
        <outputEntry id="DT_act_r24_o1"><text>"нет — справляемся сами"</text></outputEntry>
        <outputEntry id="DT_act_r24_o2"><text>"каждый понедельник"</text></outputEntry>
        <outputEntry id="DT_act_r24_o3"><text>"восстановимые"</text></outputEntry>
        <outputEntry id="DT_act_r24_o4"><text>"Источник не собирается с такой-то недели; восполним, когда площадка отдаст"</text></outputEntry>
      </rule>
      <rule id="DT_act_r25"><description>владелец, 27.10; витрина «что нового»</description>
        <inputEntry id="DT_act_r25_i0"><text>"поднялась версия витрины"</text></inputEntry>
        <inputEntry id="DT_act_r25_i1"><text>-</text></inputEntry>
