<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Defs_ponedelnik_v7" targetNamespace="demo.ctr" exporter="Camunda Modeler" exporterVersion="7.0">
  <bpmn:error id="Err_upd" name="Скрипты обновились" errorCode="SKRIPTY_OBNOVILIS" />
  <bpmn:error id="Err_stop" name="Стоп" errorCode="STOP" />
  <bpmn:collaboration id="Collab">
    <bpmn:participant id="P_mp" name="Маркетплейсы: Ozon, Wildberries, Яндекс Маркет" />
    <bpmn:participant id="P_main" name="Мониторинг CTR — понедельник" processRef="Process_main" />
    <bpmn:participant id="P_users" name="Пользователи: менеджеры МП и руководители (общий чат)" />
    <bpmn:messageFlow id="M_srv" name="снимок, метрики API" sourceRef="P_mp" targetRef="SP_srv" />
    <bpmn:messageFlow id="M_vyg" name="отчёты кабинетов" sourceRef="P_mp" targetRef="SP_vyg" />
    <bpmn:messageFlow id="M_btn" name="рынок ВБ из кабинета" sourceRef="P_mp" targetRef="SP_btn" />
    <bpmn:messageFlow id="M_users" name="витрина обновлена + проблемы" sourceRef="Task_msg" targetRef="P_users" />
    <bpmn:textAnnotation id="Ann_srok">
      <bpmn:text>Порог 17:00 — конец рабочего дня: к нему собрано всё, что портится. Витрина может уйти на завтра</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="A_srok" sourceRef="SP_vyg" targetRef="Ann_srok" />
    <bpmn:textAnnotation id="Ann_unz">
      <bpmn:text>Ловушка: лишний уровень папок (26.10)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="A_unz" sourceRef="Task_dl" targetRef="Ann_unz" />
  </bpmn:collaboration>
  <bpmn:process id="Process_main" isExecutable="false">
    <bpmn:laneSet id="LaneSet_main">
      <bpmn:lane id="L_pc" name="ПК оператора: кнопка «Понедельник»">
        <bpmn:flowNodeRef>SP_btn</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BE_stop</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BE_upd</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_op" name="Оператор прогона (владелец; без него — помощник по инструкции)">
        <bpmn:flowNodeRef>Task_dl</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_time</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Timer_next</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_prep</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_run</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_add</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_msg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_final</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP_stop</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_asst" name="Помощник оператора">
        <bpmn:flowNodeRef>Start_h</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_evt</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Ev_task</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Ev_9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_old</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_gd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_who</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_insur</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Cond_back</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP_vyg</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_srv" name="Сервер (по таймерам)">
        <bpmn:flowNodeRef>StartE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_b24</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_srv</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP_srv</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartE" name="Пн 02:00 UTC">
      <bpmn:outgoing>F1</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TD_start">
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R/2026-08-17T02:00:00Z/P7D</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:subProcess id="SP_srv" name="Подготовка на сервере">
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DOA_srv">
        <bpmn:targetRef>DOR_list</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
      <bpmn:startEvent id="S_start">
        <bpmn:outgoing>Sf1</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="S_snap" name="Снять снимок карточек трёх площадок (02:00)">
        <bpmn:incoming>Sf1</bpmn:incoming>
        <bpmn:outgoing>Sf2</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:intermediateCatchEvent id="S_t1" name="03:00 UTC">
        <bpmn:incoming>Sf2</bpmn:incoming>
        <bpmn:outgoing>Sf3</bpmn:outgoing>
        <bpmn:timerEventDefinition id="TD_s1" />
      </bpmn:intermediateCatchEvent>
      <bpmn:serviceTask id="S_sbor" name="Собрать метрики по API: Ozon, Маркет, рейтинг и остатки ВБ">
        <bpmn:incoming>Sf3</bpmn:incoming>
        <bpmn:outgoing>Sf4</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:intermediateCatchEvent id="S_t2" name="03:30 UTC">
        <bpmn:incoming>Sf4</bpmn:incoming>
        <bpmn:outgoing>Sf5</bpmn:outgoing>
        <bpmn:timerEventDefinition id="TD_s2" />
      </bpmn:intermediateCatchEvent>
      <bpmn:serviceTask id="S_pred" name="Предпрогон: сверить категории недели со справочником">
        <bpmn:incoming>Sf5</bpmn:incoming>
        <bpmn:outgoing>Sf6</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="S_end" name="Список недели готов">
        <bpmn:incoming>Sf6</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Sf1" sourceRef="S_start" targetRef="S_snap" />
      <bpmn:sequenceFlow id="Sf2" sourceRef="S_snap" targetRef="S_t1" />
      <bpmn:sequenceFlow id="Sf3" sourceRef="S_t1" targetRef="S_sbor" />
      <bpmn:sequenceFlow id="Sf4" sourceRef="S_sbor" targetRef="S_t2" />
      <bpmn:sequenceFlow id="Sf5" sourceRef="S_t2" targetRef="S_pred" />
      <bpmn:sequenceFlow id="Sf6" sourceRef="S_pred" targetRef="S_end" />
      <bpmn:textAnnotation id="S_ann1">
        <bpmn:text>Невосстановимо: снимок есть только на момент съёмки</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="S_a1" sourceRef="S_snap" targetRef="S_ann1" />
      <bpmn:textAnnotation id="S_ann2">
        <bpmn:text>Расхождения категорий не останавливают: какие и сколько — в блоке «Изменилось» списка недели</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="S_a2" sourceRef="S_pred" targetRef="S_ann2" />
    </bpmn:subProcess>
    <bpmn:dataObjectReference id="DOR_list" name="Список недели: категории, что изменилось" dataObjectRef="DO_list" />
    <bpmn:dataObject id="DO_list" />
    <bpmn:serviceTask id="Task_b24" name="Поставить задачу в Б24 с чек-листом">
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:outgoing>F3</bpmn:outgoing>
      <bpmn:property id="Prop_b24" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DIA_b24">
        <bpmn:sourceRef>DOR_list</bpmn:sourceRef>
        <bpmn:targetRef>Prop_b24</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_srv" name="Задача поставлена">
      <bpmn:incoming>F3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="Start_h" name="Пн, начало рабочего дня">
      <bpmn:outgoing>Fh1</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TD_h" />
    </bpmn:startEvent>
    <bpmn:eventBasedGateway id="G_evt">
      <bpmn:incoming>Fh1</bpmn:incoming>
      <bpmn:outgoing>Fh2</bpmn:outgoing>
      <bpmn:outgoing>Fh3</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="Ev_task" name="Задача «Сбор CTR» в Б24 есть">
      <bpmn:incoming>Fh2</bpmn:incoming>
      <bpmn:outgoing>Fh4</bpmn:outgoing>
      <bpmn:conditionalEventDefinition id="CD_task">
        <bpmn:condition xsi:type="bpmn:tFormalExpression">задача недели поставлена</bpmn:condition>
      </bpmn:conditionalEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="Ev_9" name="9:00, задачи нет">
      <bpmn:incoming>Fh3</bpmn:incoming>
      <bpmn:outgoing>Fh5</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TD_9" />
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="Task_old" name="Написать владельцу; качать по задаче прошлой недели">
      <bpmn:incoming>Fh5</bpmn:incoming>
      <bpmn:outgoing>Fh6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:subProcess id="SP_vyg" name="Ручные выгрузки по чек-листу">
      <bpmn:incoming>Fh4</bpmn:incoming>
      <bpmn:incoming>Fh6</bpmn:incoming>
      <bpmn:outgoing>F5</bpmn:outgoing>
      <bpmn:startEvent id="V_start">
        <bpmn:outgoing>Vf1</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:parallelGateway id="V_split">
        <bpmn:incoming>Vf1</bpmn:incoming>
        <bpmn:outgoing>Vf2</bpmn:outgoing>
        <bpmn:outgoing>Vf3</bpmn:outgoing>
        <bpmn:outgoing>Vf4</bpmn:outgoing>
        <bpmn:outgoing>Vf5</bpmn:outgoing>
      </bpmn:parallelGateway>
      <bpmn:userTask id="V_t1" name="Отчёт «Товары» Ozon за неделю">
        <bpmn:incoming>Vf2</bpmn:incoming>
        <bpmn:outgoing>Vf6</bpmn:outgoing>
        <bpmn:dataOutputAssociation id="V_doa1">
          <bpmn:targetRef>V_dor1</bpmn:targetRef>
        </bpmn:dataOutputAssociation>
      </bpmn:userTask>
      <bpmn:userTask id="V_t2" name="Рыночные выборки Ozon: все категории списка за один заход">
        <bpmn:incoming>Vf3</bpmn:incoming>
        <bpmn:outgoing>Vf7</bpmn:outgoing>
        <bpmn:dataOutputAssociation id="V_doa2">
          <bpmn:targetRef>V_dor2</bpmn:targetRef>
        </bpmn:dataOutputAssociation>
      </bpmn:userTask>
      <bpmn:userTask id="V_t3" name="Воронка продаж ВБ за неделю: без фильтра по артикулу, «Учитывать удалённые товары»">
        <bpmn:incoming>Vf4</bpmn:incoming>
        <bpmn:outgoing>Vf8</bpmn:outgoing>
        <bpmn:dataOutputAssociation id="V_doa3">
          <bpmn:targetRef>V_dor3</bpmn:targetRef>
        </bpmn:dataOutputAssociation>
      </bpmn:userTask>
      <bpmn:userTask id="V_t4" name="Аналитика брендов Маркета по категориям (имя как в кабинете)">
        <bpmn:incoming>Vf5</bpmn:incoming>
        <bpmn:outgoing>Vf9</bpmn:outgoing>
        <bpmn:dataOutputAssociation id="V_doa4">
          <bpmn:targetRef>V_dor4</bpmn:targetRef>
        </bpmn:dataOutputAssociation>
      </bpmn:userTask>
      <bpmn:dataObject id="V_do1" />
      <bpmn:dataObject id="V_do2" />
      <bpmn:dataObject id="V_do3" />
      <bpmn:dataObject id="V_do4" />
      <bpmn:dataObjectReference id="V_dor1" name="Товары Ozon" dataObjectRef="V_do1" />
      <bpmn:dataObjectReference id="V_dor2" name="Выборки Ozon по категориям" dataObjectRef="V_do2" />
      <bpmn:dataObjectReference id="V_dor3" name="Воронка ВБ" dataObjectRef="V_do3" />
      <bpmn:dataObjectReference id="V_dor4" name="Аналитика брендов ЯМ" dataObjectRef="V_do4" />
      <bpmn:parallelGateway id="V_join">
        <bpmn:incoming>Vf6</bpmn:incoming>
        <bpmn:incoming>Vf7</bpmn:incoming>
        <bpmn:incoming>Vf8</bpmn:incoming>
        <bpmn:incoming>Vf9</bpmn:incoming>
        <bpmn:outgoing>Vf10</bpmn:outgoing>
      </bpmn:parallelGateway>
      <bpmn:exclusiveGateway id="V_m">
        <bpmn:incoming>Vf10</bpmn:incoming>
        <bpmn:incoming>Vf15</bpmn:incoming>
        <bpmn:outgoing>Vf12</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:exclusiveGateway id="V_g" name="Все категории Ozon скачаны?">
        <bpmn:incoming>Vf12</bpmn:incoming>
        <bpmn:outgoing>Vf13</bpmn:outgoing>
        <bpmn:outgoing>Vf14</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:userTask id="V_redo" name="Докачать недостающие сегодня">
        <bpmn:incoming>Vf14</bpmn:incoming>
        <bpmn:outgoing>Vf15</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="V_check" name="Отметить галочки в чек-листе задачи">
        <bpmn:incoming>Vf13</bpmn:incoming>
        <bpmn:outgoing>Vf11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="V_end" name="Собрано">
        <bpmn:incoming>Vf11</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Vf1" sourceRef="V_start" targetRef="V_split" />
      <bpmn:sequenceFlow id="Vf2" sourceRef="V_split" targetRef="V_t1" />
      <bpmn:sequenceFlow id="Vf3" sourceRef="V_split" targetRef="V_t2" />
      <bpmn:sequenceFlow id="Vf4" sourceRef="V_split" targetRef="V_t3" />
      <bpmn:sequenceFlow id="Vf5" sourceRef="V_split" targetRef="V_t4" />
      <bpmn:sequenceFlow id="Vf6" sourceRef="V_t1" targetRef="V_join" />
      <bpmn:sequenceFlow id="Vf7" sourceRef="V_t2" targetRef="V_join" />
      <bpmn:sequenceFlow id="Vf8" sourceRef="V_t3" targetRef="V_join" />
      <bpmn:sequenceFlow id="Vf9" sourceRef="V_t4" targetRef="V_join" />
      <bpmn:sequenceFlow id="Vf10" sourceRef="V_join" targetRef="V_m" />
      <bpmn:sequenceFlow id="Vf12" sourceRef="V_m" targetRef="V_g" />
      <bpmn:sequenceFlow id="Vf13" name="да" sourceRef="V_g" targetRef="V_check" />
      <bpmn:sequenceFlow id="Vf14" name="нет" sourceRef="V_g" targetRef="V_redo" />
      <bpmn:sequenceFlow id="Vf15" sourceRef="V_redo" targetRef="V_m" />
      <bpmn:sequenceFlow id="Vf11" sourceRef="V_check" targetRef="V_end" />
      <bpmn:textAnnotation id="V_ann2">
        <bpmn:text>Окно скользит: все категории в понедельник, за один заход</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="V_a2" sourceRef="V_t2" targetRef="V_ann2" />
      <bpmn:textAnnotation id="V_ann4">
        <bpmn:text>Категория не нашлась — без галочки, причина в комментарии</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="V_a4" sourceRef="V_t4" targetRef="V_ann4" />
    </bpmn:subProcess>
    <bpmn:userTask id="Task_gd" name="Выложить на Google Диск, ссылку — в чат задачи">
      <bpmn:incoming>F5</bpmn:incoming>
      <bpmn:outgoing>F6</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DOA_gd">
        <bpmn:targetRef>DS_gd</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:dataStoreReference id="DS_gd" name="Google Диск: выгрузки недели" />
    <bpmn:exclusiveGateway id="G_who" name="Есть кому запустить кнопку сегодня?">
      <bpmn:incoming>F6</bpmn:incoming>
      <bpmn:outgoing>F7</bpmn:outgoing>
      <bpmn:outgoing>F8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_insur" name="Страховочная выгрузка рынка ВБ руками (лежит отдельно)">
      <bpmn:incoming>F8</bpmn:incoming>
      <bpmn:outgoing>F9</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:intermediateCatchEvent id="Cond_back" name="Оператор на месте">
      <bpmn:incoming>F9</bpmn:incoming>
      <bpmn:outgoing>F10</bpmn:outgoing>
      <bpmn:conditionalEventDefinition id="CD_back">
        <bpmn:condition xsi:type="bpmn:tFormalExpression">оператор на месте</bpmn:condition>
      </bpmn:conditionalEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="Task_dl" name="Скачать архив по ссылке, распаковать без лишней вложенности">
      <bpmn:incoming>F7</bpmn:incoming>
      <bpmn:incoming>F10</bpmn:incoming>
      <bpmn:outgoing>F11</bpmn:outgoing>
      <bpmn:property id="Prop_dl" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DIA_dl">
        <bpmn:sourceRef>DS_gd</bpmn:sourceRef>
        <bpmn:targetRef>Prop_dl</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="G_time" name="Успеваем до 17:00?">
      <bpmn:incoming>F11</bpmn:incoming>
      <bpmn:incoming>F15</bpmn:incoming>
      <bpmn:incoming>F21</bpmn:incoming>
      <bpmn:outgoing>F25</bpmn:outgoing>
      <bpmn:outgoing>F26</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateCatchEvent id="Timer_next" name="Следующий рабочий день">
      <bpmn:incoming>F26</bpmn:incoming>
      <bpmn:outgoing>F27</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TD_next" />
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="Task_prep" name="Закрыть Excel и окно проводника на «Загрузках»">
      <bpmn:incoming>F25</bpmn:incoming>
      <bpmn:incoming>F27</bpmn:incoming>
      <bpmn:outgoing>Fp</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_run" name="Запустить кнопку (с ключом допуска, если данных не хватает)">
      <bpmn:incoming>Fp</bpmn:incoming>
      <bpmn:incoming>F13</bpmn:incoming>
      <bpmn:outgoing>F12</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:subProcess id="SP_btn" name="Прогон кнопки">
      <bpmn:incoming>F12</bpmn:incoming>
      <bpmn:outgoing>F16</bpmn:outgoing>
      <bpmn:property id="Prop_btn" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DIA_sess">
        <bpmn:sourceRef>DS_sess</bpmn:sourceRef>
        <bpmn:targetRef>Prop_btn</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:startEvent id="SP_start">
        <bpmn:outgoing>Fs1</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="T0" name="0. Обновить скрипты из git">
        <bpmn:incoming>Fs1</bpmn:incoming>
        <bpmn:outgoing>Fs2</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:exclusiveGateway id="G0" name="Скрипты обновились?">
        <bpmn:incoming>Fs2</bpmn:incoming>
        <bpmn:outgoing>Fs3</bpmn:outgoing>
        <bpmn:outgoing>Fs4</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:endEvent id="EndE_upd" name="Перезапуск">
        <bpmn:incoming>Fs3</bpmn:incoming>
        <bpmn:errorEventDefinition id="ED_upd" errorRef="Err_upd" />
      </bpmn:endEvent>
      <bpmn:serviceTask id="T12" name="1–2. Копия папки сбора; забрать снимки и метрики с сервера">
        <bpmn:incoming>G1_da</bpmn:incoming>
        <bpmn:outgoing>Fs5</bpmn:outgoing>
        <bpmn:dataOutputAssociation id="DOA_copy">
          <bpmn:targetRef>DOR_copy</bpmn:targetRef>
        </bpmn:dataOutputAssociation>
      </bpmn:serviceTask>
      <bpmn:dataObject id="DO_copy" />
      <bpmn:dataObjectReference id="DOR_copy" name="Копия папки сбора — страховка в «Загрузках»" dataObjectRef="DO_copy" />
      <bpmn:exclusiveGateway id="G2" name="Снимок в порядке?">
        <bpmn:incoming>Fs5</bpmn:incoming>
        <bpmn:outgoing>Fs6</bpmn:outgoing>
        <bpmn:outgoing>Fs7</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:endEvent id="EndE_s2" name="Стоп: снимок">
        <bpmn:incoming>Fs6</bpmn:incoming>
        <bpmn:errorEventDefinition id="ED_s2" errorRef="Err_stop" />
      </bpmn:endEvent>
      <bpmn:serviceTask id="T3a" name="3. Открыть окно браузера, инструкция в терминале">
        <bpmn:incoming>G2b_da</bpmn:incoming>
        <bpmn:outgoing>Fs7c</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="T3w" name="Оператор: ждать загрузки кабинета ВБ (браузер сам не открывать)">
        <bpmn:incoming>Fs7c</bpmn:incoming>
        <bpmn:outgoing>Fs7d</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="T3u" name="Оператор: открыть вкладку «Воронка продаж по WB»">
        <bpmn:incoming>Fs7d</bpmn:incoming>
        <bpmn:outgoing>Fs7b</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:boundaryEvent id="BE_10" name="10 мин" attachedToRef="T3u">
        <bpmn:outgoing>Fs7t</bpmn:outgoing>
        <bpmn:timerEventDefinition id="TD_10">
          <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT10M</bpmn:timeDuration>
        </bpmn:timerEventDefinition>
      </bpmn:boundaryEvent>
      <bpmn:serviceTask id="T3" name="3. Собрать рынок ВБ (Playwright)">
        <bpmn:incoming>Fs7b</bpmn:incoming>
        <bpmn:outgoing>Fs8</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:exclusiveGateway id="G3" name="Рынок ВБ собран?">
        <bpmn:incoming>Fs8</bpmn:incoming>
        <bpmn:outgoing>Fs9</bpmn:outgoing>
        <bpmn:outgoing>Fs10</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:serviceTask id="T3b" name="Пометить: без рынка ВБ">
        <bpmn:incoming>Fs10</bpmn:incoming>
        <bpmn:incoming>Fs7t</bpmn:incoming>
        <bpmn:outgoing>Fs11</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:exclusiveGateway id="G3m">
        <bpmn:incoming>Fs9</bpmn:incoming>
        <bpmn:incoming>Fs11</bpmn:incoming>
        <bpmn:outgoing>Fs12</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:serviceTask id="T4" name="4. Разложить файлы по неделе">
        <bpmn:incoming>Fs12</bpmn:incoming>
        <bpmn:outgoing>Fs13</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:exclusiveGateway id="G4" name="Файлы разложены?">
        <bpmn:incoming>Fs13</bpmn:incoming>
        <bpmn:outgoing>Fs14</bpmn:outgoing>
        <bpmn:outgoing>Fs15</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:endEvent id="EndE_s4" name="Стоп: файлы заняты">
        <bpmn:incoming>Fs14</bpmn:incoming>
        <bpmn:errorEventDefinition id="ED_s4" errorRef="Err_stop" />
      </bpmn:endEvent>
      <bpmn:businessRuleTask id="T5" name="5. Приёмки: применить допуски (таблица DMN)">
        <bpmn:incoming>Fs15</bpmn:incoming>
        <bpmn:outgoing>Fs16</bpmn:outgoing>
      </bpmn:businessRuleTask>
      <bpmn:exclusiveGateway id="G5" name="Решение приёмки">
        <bpmn:incoming>Fs16</bpmn:incoming>
        <bpmn:outgoing>Fs17</bpmn:outgoing>
        <bpmn:outgoing>Fs18</bpmn:outgoing>
        <bpmn:outgoing>Fs19</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:endEvent id="EndE_s5" name="Стоп: код 1">
        <bpmn:incoming>Fs18</bpmn:incoming>
        <bpmn:errorEventDefinition id="ED_s5" errorRef="Err_stop" />
      </bpmn:endEvent>
      <bpmn:userTask id="T5q" name="Оператор: собирать с предупреждением?">
        <bpmn:incoming>Fs19</bpmn:incoming>
        <bpmn:outgoing>Fs20</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="G5q" name="Собирать?">
        <bpmn:incoming>Fs20</bpmn:incoming>
        <bpmn:outgoing>Fs21</bpmn:outgoing>
        <bpmn:outgoing>Fs22</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:endEvent id="EndE_s5q" name="Стоп: отказ">
        <bpmn:incoming>Fs22</bpmn:incoming>
        <bpmn:errorEventDefinition id="ED_s5q" errorRef="Err_stop" />
      </bpmn:endEvent>
      <bpmn:exclusiveGateway id="G6m">
        <bpmn:incoming>Fs17</bpmn:incoming>
        <bpmn:incoming>Fs21</bpmn:incoming>
        <bpmn:outgoing>Fs23</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:serviceTask id="T6" name="6. Собрать и выложить витрину">
        <bpmn:incoming>Fs23</bpmn:incoming>
        <bpmn:outgoing>Fs24</bpmn:outgoing>
        <bpmn:dataOutputAssociation id="DOA_full">
          <bpmn:targetRef>DOR_full</bpmn:targetRef>
        </bpmn:dataOutputAssociation>
      </bpmn:serviceTask>
      <bpmn:dataObject id="DO_full" />
      <bpmn:dataObjectReference id="DOR_full" name="Полнота сбора: что требует внимания" dataObjectRef="DO_full" />
      <bpmn:serviceTask id="T7" name="7. Копия на сервер (сбой — не стоп)">
        <bpmn:incoming>G6b_da</bpmn:incoming>
        <bpmn:outgoing>Fs25</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="SP_end" name="Витрина выложена">
        <bpmn:incoming>Fs25</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Fs1" sourceRef="SP_start" targetRef="T0" />
      <bpmn:sequenceFlow id="Fs2" sourceRef="T0" targetRef="G0" />
      <bpmn:sequenceFlow id="Fs3" name="да" sourceRef="G0" targetRef="EndE_upd" />
      <bpmn:sequenceFlow id="Fs4" name="нет" sourceRef="G0" targetRef="G1" />
      <bpmn:sequenceFlow id="Fs5" sourceRef="T12" targetRef="G2" />
      <bpmn:sequenceFlow id="Fs6" name="нет" sourceRef="G2" targetRef="EndE_s2" />
      <bpmn:sequenceFlow id="Fs7" name="да" sourceRef="G2" targetRef="G2b" />
      <bpmn:sequenceFlow id="Fs7c" sourceRef="T3a" targetRef="T3w" />
      <bpmn:sequenceFlow id="Fs7d" sourceRef="T3w" targetRef="T3u" />
      <bpmn:sequenceFlow id="Fs7t" name="не успели" sourceRef="BE_10" targetRef="T3b" />
      <bpmn:sequenceFlow id="Fs7b" sourceRef="T3u" targetRef="T3" />
      <bpmn:sequenceFlow id="Fs8" sourceRef="T3" targetRef="G3" />
      <bpmn:sequenceFlow id="Fs9" name="да" sourceRef="G3" targetRef="G3m" />
      <bpmn:sequenceFlow id="Fs10" name="нет" sourceRef="G3" targetRef="T3b" />
      <bpmn:sequenceFlow id="Fs11" sourceRef="T3b" targetRef="G3m" />
      <bpmn:sequenceFlow id="Fs12" sourceRef="G3m" targetRef="T4" />
      <bpmn:sequenceFlow id="Fs13" sourceRef="T4" targetRef="G4" />
      <bpmn:sequenceFlow id="Fs14" name="нет" sourceRef="G4" targetRef="EndE_s4" />
      <bpmn:sequenceFlow id="Fs15" name="да" sourceRef="G4" targetRef="T5" />
      <bpmn:sequenceFlow id="Fs16" sourceRef="T5" targetRef="G5" />
      <bpmn:sequenceFlow id="Fs17" name="0 — дальше" sourceRef="G5" targetRef="G6m" />
      <bpmn:sequenceFlow id="Fs18" name="1 — стоп" sourceRef="G5" targetRef="EndE_s5" />
      <bpmn:sequenceFlow id="Fs19" name="2 — предупреждение" sourceRef="G5" targetRef="T5q" />
      <bpmn:sequenceFlow id="Fs20" sourceRef="T5q" targetRef="G5q" />
      <bpmn:sequenceFlow id="Fs21" name="да" sourceRef="G5q" targetRef="G6m" />
      <bpmn:sequenceFlow id="Fs22" name="нет" sourceRef="G5q" targetRef="EndE_s5q" />
      <bpmn:sequenceFlow id="Fs23" sourceRef="G6m" targetRef="T6" />
      <bpmn:sequenceFlow id="Fs24" sourceRef="T6" targetRef="G6b" />
      <bpmn:sequenceFlow id="Fs25" sourceRef="T7" targetRef="SP_end" />
      <bpmn:exclusiveGateway id="G1" name="Папка сбора есть?">
        <bpmn:incoming>Fs4</bpmn:incoming>
        <bpmn:outgoing>G1_da</bpmn:outgoing>
        <bpmn:outgoing>G1_net</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:sequenceFlow id="G1_da" name="да" sourceRef="G1" targetRef="T12" />
      <bpmn:sequenceFlow id="G1_net" name="нет" sourceRef="G1" targetRef="EndE_s1" />
      <bpmn:endEvent id="EndE_s1" name="Стоп: нет папки сбора">
        <bpmn:incoming>G1_net</bpmn:incoming>
        <bpmn:errorEventDefinition id="ED_EndE_s1" errorRef="Err_stop" />
      </bpmn:endEvent>
      <bpmn:exclusiveGateway id="G2b" name="Выгрузки сервера забрались?">
        <bpmn:incoming>Fs7</bpmn:incoming>
        <bpmn:outgoing>G2b_da</bpmn:outgoing>
        <bpmn:outgoing>G2b_net</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:sequenceFlow id="G2b_da" name="да" sourceRef="G2b" targetRef="T3a" />
      <bpmn:sequenceFlow id="G2b_net" name="нет" sourceRef="G2b" targetRef="EndE_s2b" />
      <bpmn:endEvent id="EndE_s2b" name="Стоп: выгрузки сервера">
        <bpmn:incoming>G2b_net</bpmn:incoming>
        <bpmn:errorEventDefinition id="ED_EndE_s2b" errorRef="Err_stop" />
      </bpmn:endEvent>
      <bpmn:exclusiveGateway id="G6b" name="Сборка и выкладка прошли?">
        <bpmn:incoming>Fs24</bpmn:incoming>
        <bpmn:outgoing>G6b_da</bpmn:outgoing>
        <bpmn:outgoing>G6b_net</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:sequenceFlow id="G6b_da" name="да" sourceRef="G6b" targetRef="T7" />
      <bpmn:sequenceFlow id="G6b_net" name="нет" sourceRef="G6b" targetRef="EndE_s6" />
      <bpmn:endEvent id="EndE_s6" name="Стоп: сборка">
        <bpmn:incoming>G6b_net</bpmn:incoming>
        <bpmn:errorEventDefinition id="ED_EndE_s6" errorRef="Err_stop" />
      </bpmn:endEvent>
      <bpmn:textAnnotation id="Ann_win">
        <bpmn:text>Окно может открыться свёрнутым — смотреть панель задач</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="A_win" sourceRef="T3w" targetRef="Ann_win" />
      <bpmn:association id="A_pw2" sourceRef="T3u" targetRef="Ann_pw" />
      <bpmn:textAnnotation id="Ann_pw">
        <bpmn:text>Сессия кабинета ВБ живёт только на ПК оператора — кнопку запускать с него. Код с почты обычно не нужен</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="A_pw" sourceRef="T3" targetRef="Ann_pw" />
    </bpmn:subProcess>
    <bpmn:dataStoreReference id="DS_sess" name="Сессия кабинета ВБ (только этот ПК)" />
    <bpmn:subProcess id="SP_stop" name="Разбор стопа">
      <bpmn:incoming>F14</bpmn:incoming>
      <bpmn:outgoing>F15</bpmn:outgoing>
      <bpmn:startEvent id="R_start">
        <bpmn:outgoing>Rf1</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:exclusiveGateway id="R_oz" name="Беда в рыночных выборках Ozon?">
        <bpmn:incoming>Rs_no</bpmn:incoming>
        <bpmn:outgoing>Rf2</bpmn:outgoing>
        <bpmn:outgoing>Rf3</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:userTask id="R_ozt" name="Перевыгрузить выборки Ozon сегодня же">
        <bpmn:incoming>Rf2</bpmn:incoming>
        <bpmn:outgoing>Rf4</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="R_ozm">
        <bpmn:incoming>Rf3</bpmn:incoming>
        <bpmn:incoming>Rf4</bpmn:incoming>
        <bpmn:outgoing>Rf5</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:exclusiveGateway id="R_fix" name="Нужна правка сервера или скриптов?">
        <bpmn:incoming>Rf5</bpmn:incoming>
        <bpmn:outgoing>Rf6</bpmn:outgoing>
        <bpmn:outgoing>Rf7</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:userTask id="R_claude" name="Починить в паре с Claude по инструкции">
        <bpmn:incoming>Rf6</bpmn:incoming>
        <bpmn:outgoing>Rf8</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="R_own" name="Владелец правит скрипты или сервер (журнал уже у него)">
        <bpmn:incoming>Rf7</bpmn:incoming>
        <bpmn:outgoing>Rf9</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="R_end1" name="Готово к перезапуску">
        <bpmn:incoming>Rf8</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:endEvent id="R_end2" name="Готово к перезапуску">
        <bpmn:incoming>Rf9</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Rf1" sourceRef="R_start" targetRef="R_sn" />
      <bpmn:sequenceFlow id="Rf2" name="да" sourceRef="R_oz" targetRef="R_ozt" />
      <bpmn:sequenceFlow id="Rf3" name="нет" sourceRef="R_oz" targetRef="R_ozm" />
      <bpmn:sequenceFlow id="Rf4" sourceRef="R_ozt" targetRef="R_ozm" />
      <bpmn:sequenceFlow id="Rf5" sourceRef="R_ozm" targetRef="R_fix" />
      <bpmn:sequenceFlow id="Rf6" name="нет" sourceRef="R_fix" targetRef="R_claude" />
      <bpmn:sequenceFlow id="Rf7" name="да" sourceRef="R_fix" targetRef="R_own" />
      <bpmn:sequenceFlow id="Rf8" sourceRef="R_claude" targetRef="R_end1" />
      <bpmn:sequenceFlow id="Rf9" sourceRef="R_own" targetRef="R_end2" />
      <bpmn:exclusiveGateway id="R_sn" name="Беда в снимке?">
        <bpmn:incoming>Rf1</bpmn:incoming>
        <bpmn:outgoing>Rs_yes</bpmn:outgoing>
        <bpmn:outgoing>Rs_no</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:userTask id="R_snt" name="Владелец: перезапустить снимок на сервере сегодня">
        <bpmn:incoming>Rs_yes</bpmn:incoming>
        <bpmn:outgoing>Rs_end</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="R_end0" name="Готово к перезапуску">
        <bpmn:incoming>Rs_end</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Rs_yes" name="да" sourceRef="R_sn" targetRef="R_snt" />
      <bpmn:sequenceFlow id="Rs_no" name="нет" sourceRef="R_sn" targetRef="R_oz" />
      <bpmn:sequenceFlow id="Rs_end" sourceRef="R_snt" targetRef="R_end0" />
      <bpmn:textAnnotation id="Ann_snap">
        <bpmn:text>Ручных выгрузок взамен снимка нет. Команду проверить прогоном вхолостую; на следующий день изменения недели не вернуть</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="A_snap" sourceRef="R_snt" targetRef="Ann_snap" />
    </bpmn:subProcess>
    <bpmn:userTask id="Task_check" name="Открыть витрину, пройтись глазами">
      <bpmn:incoming>F16</bpmn:incoming>
      <bpmn:outgoing>F17</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="G_check" name="Данных хватает?">
      <bpmn:incoming>F17</bpmn:incoming>
      <bpmn:outgoing>F18</bpmn:outgoing>
      <bpmn:outgoing>F19</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_add" name="Доложить недостающее или выбрать ключ допуска">
      <bpmn:incoming>F19</bpmn:incoming>
      <bpmn:outgoing>F21</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="Task_msg" name="Написать пользователям: неделя обновлена, нюансы недели, что нового">
      <bpmn:incoming>F18</bpmn:incoming>
      <bpmn:outgoing>F24</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="End_final" name="Пользователи знают, чему на витрине верить">
      <bpmn:incoming>F24</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:boundaryEvent id="BE_stop" name="Стоп" attachedToRef="SP_btn">
      <bpmn:outgoing>F14</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ED_be_stop" errorRef="Err_stop" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="BE_upd" name="Скрипты обновились" attachedToRef="SP_btn">
      <bpmn:outgoing>F13</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ED_be_upd" errorRef="Err_upd" />
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="F1" sourceRef="StartE" targetRef="SP_srv" />
