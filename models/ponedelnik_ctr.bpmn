    <bpmn:sequenceFlow id="F15" sourceRef="SP_stop" targetRef="G_time" />
    <bpmn:sequenceFlow id="F21" sourceRef="Task_add" targetRef="G_time" />
    <bpmn:sequenceFlow id="F25" name="да" sourceRef="G_time" targetRef="Task_prep" />
    <bpmn:sequenceFlow id="F26" name="нет — витрина завтра" sourceRef="G_time" targetRef="Timer_next" />
    <bpmn:sequenceFlow id="F27" sourceRef="Timer_next" targetRef="Task_prep" />
    <bpmn:sequenceFlow id="Fp" sourceRef="Task_prep" targetRef="Task_run" />
    <bpmn:sequenceFlow id="F13" sourceRef="BE_upd" targetRef="Task_run" />
    <bpmn:sequenceFlow id="F12" sourceRef="Task_run" targetRef="SP_btn" />
    <bpmn:sequenceFlow id="F16" sourceRef="SP_btn" targetRef="Task_check" />
    <bpmn:sequenceFlow id="F14" sourceRef="BE_stop" targetRef="SP_stop" />
