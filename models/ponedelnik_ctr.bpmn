    <bpmn:sequenceFlow id="F19" name="нет" sourceRef="G_check" targetRef="Task_add" />
    <bpmn:sequenceFlow id="F24" sourceRef="Task_msg" targetRef="End_final" />
    <bpmn:textAnnotation id="Ann_design">
      <bpmn:text>Замечания по оформлению — вне прогона: отдельная задача с Claude, в задаче не фиксируются</bpmn:text>
    </bpmn:textAnnotation>
